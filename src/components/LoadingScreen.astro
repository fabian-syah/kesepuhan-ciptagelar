---
---

<div
  id="app-loader"
  class="fixed inset-0 z-[9999] bg-[#1C1814] flex flex-col items-center justify-center transition-all duration-700 ease-out select-none"
  aria-hidden="true"
>
  <div class="flex flex-col items-center text-center px-6">
    <div class="w-8 h-[1px] bg-[#C89B3C] mb-6"></div>

    <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-light tracking-[0.16em] text-[#F7F5EE] uppercase">
      CIPTAGELAR
    </h2>

    <p class="text-[11px] sm:text-xs uppercase tracking-[0.45em] text-[#F7F5EE]/65 font-sans mt-3.5">
      Sukabumi, West Java
    </p>

    <div class="w-48 sm:w-60 h-[1px] bg-[#F7F5EE]/15 mt-8 overflow-hidden relative">
      <div
        id="loader-progress-bar"
        class="h-full w-0 bg-[#C89B3C] transition-all duration-200 ease-out"
      ></div>
    </div>

    <span
      id="loader-percentage"
      class="text-[10px] font-mono text-[#F7F5EE]/50 mt-3 tabular-nums tracking-widest"
    >
      00%
    </span>
  </div>
</div>

<script>
  const loader = document.getElementById('app-loader');
  const bar = document.getElementById('loader-progress-bar');
  const counter = document.getElementById('loader-percentage');

  if (loader && bar && counter) {
    let progress = 0;
    let isLoaded = false;

    const updateProgress = (val: number) => {
      progress = Math.min(100, Math.max(progress, val));
      bar.style.width = `${progress}%`;
      counter.textContent = `${String(Math.round(progress)).padStart(2, '0')}%`;
    };

    updateProgress(18);

    const step1 = setTimeout(() => updateProgress(45), 180);
    const step2 = setTimeout(() => updateProgress(78), 420);
    const step3 = setTimeout(() => updateProgress(92), 700);

    const finishLoading = () => {
      if (isLoaded) return;
      isLoaded = true;

      clearTimeout(step1);
      clearTimeout(step2);
      clearTimeout(step3);

      updateProgress(100);

      setTimeout(() => {
        loader.style.opacity = '0';
        loader.style.pointerEvents = 'none';
        loader.style.transform = 'scale(1.02)';

        setTimeout(() => {
          loader.remove();
        }, 700);
      }, 250);
    };

    if (document.readyState === 'complete') {
      setTimeout(finishLoading, 400);
    } else {
      window.addEventListener('load', finishLoading, { once: true });
      setTimeout(finishLoading, 2200);
    }
  }
</script>
