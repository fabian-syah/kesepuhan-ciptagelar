---
---

<header
  id="site-navbar"
  class="fixed top-0 left-0 w-full h-16 z-50 transition-transform duration-300 ease-in-out font-sans bg-[#1C1814] border-b border-[#F7F5EE]/10 px-6 md:px-12 flex items-center justify-between shadow-md"
>
  <div>
    <a
      href="#top"
      class="text-xl md:text-2xl font-light tracking-[0.08em] font-serif leading-none text-[#F7F5EE] hover:text-[#C89B3C] transition-colors select-none"
    >
      CIPTAGELAR
    </a>
  </div>

  <nav class="hidden md:flex items-center gap-8 lg:gap-12 text-[15px] font-medium font-sans text-[#F7F5EE]">
    <a
      href="#top"
      class="hover:text-[#C89B3C] transition-colors"
      data-lang-en="Welcome"
      data-lang-id="Selamat Datang"
    >
      Welcome
    </a>
    <a
      href="#gallery"
      class="hover:text-[#C89B3C] transition-colors"
      data-lang-en="Gallery"
      data-lang-id="Galeri"
    >
      Gallery
    </a>
    <a
      href="#visit"
      class="hover:text-[#C89B3C] transition-colors"
      data-lang-en="Visit"
      data-lang-id="Kunjungan"
    >
      Visit
    </a>
  </nav>

  <div class="flex items-center gap-4">
    <div
      class="flex items-center gap-1.5 text-xs font-sans tracking-wider uppercase border border-[#F7F5EE]/30 rounded px-2.5 py-1 bg-[#1C1814]"
    >
      <button
        id="lang-btn-en"
        type="button"
        data-lang-btn="en"
        class="transition-colors text-[#C89B3C] font-semibold cursor-pointer px-1 py-0.5"
        aria-label="Switch language to English"
      >
        EN
      </button>
      <span class="text-[#F7F5EE]/30 select-none">|</span>
      <button
        id="lang-btn-id"
        type="button"
        data-lang-btn="id"
        class="transition-colors text-[#F7F5EE]/70 hover:text-[#F7F5EE] cursor-pointer px-1 py-0.5"
        aria-label="Ganti bahasa ke Bahasa Indonesia"
      >
        ID
      </button>
    </div>
  </div>
</header>

<script>
  import { getInitialLanguage, setLanguage } from '../utils/langStore';

  const btnEn = document.getElementById('lang-btn-en');
  const btnId = document.getElementById('lang-btn-id');
  const navbar = document.getElementById('site-navbar');

  const currentLang = getInitialLanguage();
  setLanguage(currentLang);

  btnEn?.addEventListener('click', () => {
    setLanguage('en');
  });

  btnId?.addEventListener('click', () => {
    setLanguage('id');
  });

  if (navbar) {
    let lastScrollY = window.scrollY;
    let ticking = false;

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            const currentScrollY = window.scrollY;
            if (currentScrollY > lastScrollY && currentScrollY > 80) {
              navbar.classList.add('-translate-y-full');
            } else if (currentScrollY < lastScrollY) {
              navbar.classList.remove('-translate-y-full');
            }
            lastScrollY = Math.max(0, currentScrollY);
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true }
    );
  }
</script>
